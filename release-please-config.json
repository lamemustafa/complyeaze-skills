{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-v-in-tag": true,
  "prerelease": true,
  "bump-minor-pre-major": false,
  "pull-request-footer": "Generated by Release Please.\n\n**Release review checklist** \u2014 this PR should contain release metadata only. Confirm before merging:\n- No rate, threshold, deadline or form-selection behaviour is changed by this PR.\n- No taxpayer data, PAN, acknowledgement number or ITR JSON appears in the changelog.\n- The version in `SKILL.md` and `.claude-plugin/marketplace.json` matches the tag.",
  "packages": {
    ".": {
      "package-name": "complyeaze-skills",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "json",
          "path": ".claude-plugin/marketplace.json",
          "jsonpath": "$.metadata.version"
        },
        {
          "type": "json",
          "path": ".claude-plugin/marketplace.json",
          "jsonpath": "$.plugins[0].version"
        },
        {
          "type": "generic",
          "path": "skills/itr-filing-copilot/SKILL.md"
        },
        {
          "type": "generic",
          "path": "README.md"
        }
      ],
      "changelog-sections": [
        {
          "type": "feat",
          "section": "Features"
        },
        {
          "type": "fix",
          "section": "Fixes"
        },
        {
          "type": "docs",
          "section": "Documentation"
        },
        {
          "type": "test",
          "section": "Tests"
        },
        {
          "type": "chore",
          "section": "Maintenance"
        },
        {
          "type": "refactor",
          "section": "Maintenance"
        }
      ]
    }
  },
  "bump-patch-for-minor-pre-major": true
}
